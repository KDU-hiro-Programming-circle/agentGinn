# Discord bot token (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Optional: guild id for instant (guild-scoped) slash command sync.
# Leave empty to sync commands globally instead (can take up to ~1h to propagate).
GUILD_ID=

# SwitchBot OpenAPI v1.1 credentials (SwitchBot app > Profile > Preferences > App Version x10 > Get Token)
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# Path to the SQLite database file
DATABASE_PATH=database/agentginn.db
